# ─── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/content_machine

# Express session secret (random 32+ char string)
SESSION_SECRET=change-me-to-a-random-secret

# Encrypts two-factor secrets at rest (any long random string). Keep it when rotating SESSION_SECRET.
MFA_ENCRYPTION_KEY=change-me-to-a-different-random-secret

# Workspace sign-in password and admin elevation (required; set in the platform secret store)
ADMIN_PASSWORD=change-me-in-the-platform-secret-manager

# Server port
PORT=8080

# ─── Optional ─────────────────────────────────────────────────────────────────

# Comma-separated allowed CORS origins (platform-neutral, in addition to localhost)
# ALLOWED_ORIGINS=https://your-app.onrender.com

# Frontend build directory path (default: auto-resolved from monorepo structure)
# FRONTEND_DIST_PATH=/path/to/content-os/dist/public

# Upload directory for images (default: ./uploads/images)
# UPLOAD_DIR=/path/to/uploads/images

# Durable PDF-source and generated-export directories
# SOURCE_UPLOAD_DIR=/path/to/uploads/sources
# EXPORT_DIR=/path/to/data/exports

# Grant Studio notice PDFs (docs/GRANT_STUDIO.md). Defaults: 25 MB and 200 pages
# (hard ceilings 50 MB and 400 pages). Text is read with pdf.js in process.
# NOTICE_PDF_MAX_MB=25
# NOTICE_PDF_MAX_PAGES=200
# Optional Docling service (docling-serve) for text extraction; pdf.js is used when unset
# or when the service fails. Not part of render.yaml: running it is an owner decision.
# DOCLING_SERVE_URL=http://localhost:5001
# DOCLING_SERVE_API_KEY=
# DOCLING_TIMEOUT_MS=120000

# AI provider key. At least one of OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY is
# required in production (/api/readyz fails without one); locally the app falls back to
# clearly labelled demo output.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Grant source registry page watcher (docs/SOURCE_REGISTRY.md). Default: the built-in fetcher.
# SOURCE_WATCHER_BACKEND=builtin            # or changedetection (a self-hosted changedetection.io; owner decision)
# CHANGEDETECTION_URL=http://127.0.0.1:5000
# CHANGEDETECTION_API_KEY=
# CHANGEDETECTION_MODE=webhook              # or poll
# CHANGEDETECTION_RECEIVER_URL=http://host.docker.internal:8080/api/watch-events/changedetection
# CHANGEDETECTION_WEBHOOK_SECRET=           # 24+ random characters
# SOURCE_STALE_DAYS=3
# SOURCE_FETCH_MIN_INTERVAL_MS=10000
# SOURCE_EXTRACT_MODEL=
# SOURCE_WATCH_DISABLED=true

# Optional: real social publishing through Typefully
# TYPEFULLY_API_KEY=

# Commit reported by /api/healthz for deployment parity (Render sets RENDER_GIT_COMMIT itself)
# GIT_COMMIT=

# Maximum AI provider request duration in milliseconds (default: 30000)
# AI_PROVIDER_TIMEOUT_MS=30000

# Self sign-up and the public landing page (docs/SELF_SIGNUP.md). Off by default:
# signed-out visitors see only the sign-in screen. The switch is SELF_SIGNUP_ENABLED=true;
# SELF_SERVE_SIGNUP=on (the name the first landing-page release used) works the same.
# Either way sign-up stays off until an email provider and APP_BASE_URL are also set,
# because every new account must confirm its email before any workspace exists.
# On: grantcrest.co shows the landing page, /signup emails a one-time link, and opening
# it creates the person's account and their own client workspace.
# SELF_SIGNUP_ENABLED=true
# SELF_SERVE_SIGNUP=on
# EMAIL_PROVIDER=resend        # or "log" for local development only (refused in production)
# RESEND_API_KEY=
# EMAIL_FROM=GrantCrest <hello@grantcrest.co>
# APP_BASE_URL=http://localhost:5173   # also used by billing below; the email link is APP_BASE_URL/signup/verify#token=...
# SELF_SIGNUP_TRIAL_PLAN=starter        # the trial plan for a new workspace when billing is on

# Billing (docs/BILLING.md). Off unless all three are set; with billing off nothing is limited.
# Never put real values in this file. Use Stripe test keys (sk_test_...) locally.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# APP_BASE_URL=http://localhost:5173
# BILLING_DISABLED=true

# Node environment
NODE_ENV=development
