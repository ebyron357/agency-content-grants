# ─── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/content_machine

# Express session secret (random 32+ char string)
SESSION_SECRET=change-me-to-a-random-secret

# Workspace sign-in password and admin elevation (required; set in the platform secret store)
ADMIN_PASSWORD=change-me-in-the-platform-secret-manager

# Server port
PORT=8080

# ─── Optional ─────────────────────────────────────────────────────────────────

# Comma-separated allowed CORS origins (platform-neutral, in addition to localhost)
# ALLOWED_ORIGINS=https://your-app.onrender.com

# Frontend build directory path (default: auto-resolved from monorepo structure)
# FRONTEND_DIST_PATH=/path/to/content-os/dist/public

# Upload directory for images (default: ./uploads/images)
# UPLOAD_DIR=/path/to/uploads/images

# Durable PDF-source and generated-export directories
# SOURCE_UPLOAD_DIR=/path/to/uploads/sources
# EXPORT_DIR=/path/to/data/exports

# AI provider key. At least one of OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY is
# required in production (/api/readyz fails without one); locally the app falls back to
# clearly labelled demo output.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Optional: real social publishing through Typefully
# TYPEFULLY_API_KEY=

# Commit reported by /api/healthz for deployment parity (Render sets RENDER_GIT_COMMIT itself)
# GIT_COMMIT=

# Maximum AI provider request duration in milliseconds (default: 30000)
# AI_PROVIDER_TIMEOUT_MS=30000

# Node environment
NODE_ENV=development
