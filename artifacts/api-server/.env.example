# ── Content OS — API Server environment ──────────────────────────────────────
# Copy to your secret manager / .env (never commit real values).
# On Replit, set these via the Secrets tool; DATABASE_* vars are provisioned
# automatically by the Replit PostgreSQL integration.

# ── Required ─────────────────────────────────────────────────────────────────
# Session signing secret (any long random string). REQUIRED — the server
# refuses to start without it in production.
SESSION_SECRET=change-me-to-a-long-random-string

# PostgreSQL (auto-provisioned on Replit; required for any non-Replit deploy)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# PGHOST=...
# PGPORT=5432
# PGUSER=...
# PGPASSWORD=...
# PGDATABASE=...

# Shared admin password — unlocks admin-only mutations on global resources
# (model configuration, content blueprints, dependency registry, provider
# connection tests) via POST /api/auth/admin-unlock. If unset, those routes
# stay locked for everyone; normal app usage is unaffected.
ADMIN_PASSWORD=

# ── AI providers (at least one required for generation features) ─────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=          # or GOOGLE_AI_API_KEY

# ── Object storage (PDF source uploads) ──────────────────────────────────────
# Auto-configured on Replit when App Storage is enabled.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# ── Optional ─────────────────────────────────────────────────────────────────
# Port the API listens on. Replit assigns PORT automatically per artifact.
PORT=8080
# NODE_ENV=development|production   (set by the dev/start scripts)
# LOG_LEVEL=info                    (pino level: debug|info|warn|error)
